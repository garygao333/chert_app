# OpenAI API Configuration
# To enable real speech-to-text transcription, add your OpenAI API key below
# and rename this file to .env

# Get your API key from: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Other optional configurations
# EXPO_PUBLIC_GOOGLE_SPEECH_API_KEY=your_google_api_key_here
# EXPO_PUBLIC_AZURE_SPEECH_KEY=your_azure_key_here
# EXPO_PUBLIC_AZURE_SPEECH_REGION=your_azure_region_here
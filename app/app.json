{
  "expo": {
    "name": "Chert",
    "slug": "chert-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chert.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to microphone for voice recording of archaeological data.",
        "NSCameraUsageDescription": "This app needs access to camera for photographing archaeological artifacts.",
        "NSLocationWhenInUseUsageDescription": "This app needs location access to record GPS coordinates of archaeological finds."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.chert.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-av",
      "expo-image-picker",
      "expo-location"
    ],
    "extra": {
      "apiUrl": "http://192.168.7.214:8000"
    }
  }
}
